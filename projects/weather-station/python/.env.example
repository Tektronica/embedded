# Shared by every package
DATABASE_PATH=instance/weather.sqlite3

# sensors (pins and addresses live in sensors.toml)
SENSORS_CONFIG=sensors.toml
INTERVAL_SECONDS=60
RETENTION_DAYS=30

# web
STALE_AFTER_MINUTES=5

# notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_TO=recipient@example.com
