{
  "storage": {
    "database_path": "instance/weather.sqlite3"
  },
  "sensors": {
    "interval_seconds": 60,
    "retention_days": 30,
    "devices": [
      { "id": "room-am2302", "model": "am2302", "gpio": 4 }
    ]
  },
  "status": {
    "stale_after_minutes": 5
  },
  "alarms": [
    { "sensor": "room-am2302", "property": "air-temperature", "above": 35.0, "below": 0.0, "hysteresis": 1.0 }
  ],
  "email": {
    "smtp_host": "smtp.gmail.com",
    "smtp_port": 465,
    "recipients": ["you@example.com"]
  }
}
